# Copy this file to ".env" and fill in real values. Never commit the real ".env".

DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Set to True to use sqlite3 instead of Postgres (useful for a quick first run
# before Postgres is installed/configured).
USE_SQLITE=True

# Postgres connection (used when USE_SQLITE=False)
DB_NAME=solaryield_db
DB_USER=solaryield_user
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432
